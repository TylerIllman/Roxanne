{
  "name": "jarvis-assistant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace apps/desktop run dev",
    "dev:backend": "python3 -m uvicorn jarvis_backend.main:app --reload --app-dir apps/backend",
    "build:desktop": "npm --workspace apps/desktop run build",
    "lint:desktop": "npm --workspace apps/desktop run lint"
  }
}

